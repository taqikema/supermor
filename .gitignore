# Numerical and rendering outputs are generated locally.
/outputs/**
!/outputs/**/
!/outputs/**/.gitkeep
__pycache__/
*.pyc
/build/
/dist/
/core/*.egg-info/
.pytest_cache/

# Mesh inputs and generated artifacts share one local data tree.
# Only the small, required independent inputs are included in the Git release.
/data/mesh_data/**
!/data/mesh_data/**/
!/data/mesh_data/case2_layered_sphere/inputs/sphere_surface_template.npz
!/data/mesh_data/case3_mr3d/prepared/manifest.json
!/data/mesh_data/case3_mr3d/prepared/survey.npz
