# Numerical and rendering outputs are generated locally.
/outputs/**
!/outputs/**/
!/outputs/**/.gitkeep
__pycache__/
*.pyc
/build/
/dist/
/core/*.egg-info/
.pytest_cache/

# Mesh inputs and generated artifacts share one local data tree.
# Only the small, required independent inputs are included in the Git release.
/data/mesh_data/**
!/data/mesh_data/**/
!/data/mesh_data/case2_layered_sphere/inputs/sphere_surface_template.npz
!/data/mesh_data/case3_mr3d/prepared/manifest.json
!/data/mesh_data/case3_mr3d/prepared/survey.npz

# Independent model arrays and frozen validation responses are data downloads.
/data/model_data/**
/data/reference_data/**

# Complete original model volumes are local/downloaded figure inputs.
/data/raw_data/**

# Figure 7's complete VTK scene is supplied with the separate dataset.
/data/figure_data/case2_layered_sphere/geometry/

# Renderings and their provenance are regenerated beside figure scripts.
/figs/case*/fig[0-9][0-9]_*.png
/figs/case*/fig[0-9][0-9]_*.pdf
/figs/case*/fig[0-9][0-9]_*.svg
/figs/case*/fig[0-9][0-9]_*_metadata.json
